{
  "name": "@checodo/better-auth-normalize",
  "version": "0.2.1",
  "description": "Email and phone number normalization for better-auth: one account per inbox, and phone numbers in E.164.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Clas Heinemeyer",
    "email": "the.checodo@gmail.com",
    "url": "https://checodo.dev"
  },
  "homepage": "https://checodo-better-auth-plugins.vercel.app/docs/normalize",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checodo/better-auth-plugins.git",
    "directory": "packages/normalize"
  },
  "bugs": {
    "url": "https://github.com/checodo/better-auth-plugins/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "normalize",
    "email",
    "phone-number",
    "username",
    "auth"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@better-auth/core": "catalog:",
    "better-auth": "catalog:"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.17",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "catalog:",
    "@checodo/better-auth-audit-log": "workspace:*",
    "@repo/plugin-utils": "workspace:*",
    "@repo/tooling": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

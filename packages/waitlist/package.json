{
  "name": "@checodo/better-auth-waitlist",
  "version": "0.4.1",
  "description": "Gate sign-ups behind a waitlist with admin approval and invite codes in better-auth.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Clas Heinemeyer",
    "email": "the.checodo@gmail.com",
    "url": "https://checodo.dev"
  },
  "homepage": "https://checodo-better-auth-plugins.vercel.app/docs/waitlist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checodo/better-auth-plugins.git",
    "directory": "packages/waitlist"
  },
  "bugs": {
    "url": "https://github.com/checodo/better-auth-plugins/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "waitlist",
    "invite",
    "auth"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:db": "vitest run test/waitlist.test.ts -t \"concurrent|race|out of order|at once|deleted|findAll\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@better-auth/core": "catalog:",
    "better-auth": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "catalog:",
    "@repo/plugin-utils": "workspace:*",
    "@repo/tooling": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

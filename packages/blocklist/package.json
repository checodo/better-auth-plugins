{
  "name": "@checodo/better-auth-blocklist",
  "version": "0.1.0",
  "description": "Block disallowed emails, usernames, and organization/team names in better-auth.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Clas Heinemeyer",
    "email": "the.checodo@gmail.com",
    "url": "https://checodo.dev"
  },
  "homepage": "https://github.com/checodo/better-auth-plugins/tree/main/packages/blocklist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checodo/better-auth-plugins.git",
    "directory": "packages/blocklist"
  },
  "bugs": {
    "url": "https://github.com/checodo/better-auth-plugins/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "blocklist",
    "denylist",
    "auth"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./lists": {
      "types": "./dist/lists.d.ts",
      "default": "./dist/lists.js"
    },
    "./lists/disposable-email-domains": {
      "types": "./dist/lists/disposable-email-domains.d.ts",
      "default": "./dist/lists/disposable-email-domains.js"
    },
    "./lists/reserved-usernames": {
      "types": "./dist/lists/reserved-usernames.d.ts",
      "default": "./dist/lists/reserved-usernames.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "lists:update": "node scripts/update-lists.ts"
  },
  "peerDependencies": {
    "@better-auth/core": "catalog:",
    "better-auth": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "catalog:",
    "@repo/plugin-utils": "workspace:*",
    "@repo/tooling": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

# Copy to .env.local. Both have working defaults for local development.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Optional, for the "Sign-in providers" page. Steam works without any of these.
# Steam Web API key (https://steamcommunity.com/dev/apikey): adds names and avatars.
STEAM_API_KEY=
# Epic Developer Portal client; redirect URL http://localhost:3001/api/auth/callback/epic
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
# Microsoft Entra ID app with Xbox access; redirect URL http://localhost:3001/api/auth/callback/xbox
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

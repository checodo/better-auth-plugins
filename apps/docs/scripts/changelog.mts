/**
 * Writes the Changelog section of the docs (`content/docs/changelog/`,
 * git-ignored) from each published package's `CHANGELOG.md`, which
 * Changesets writes when it versions the packages: an overview page with
 * each plugin's current version, and one page per plugin with its
 * versions (newest first, as Changesets writes them), each with a link to
 * its GitHub release and the commit of each entry linked.
 *
 * Runs before `dev`, `build`, and `typecheck`, so every docs build,
 * including the deploy after a release, shows the changelogs of that
 * commit; nothing to update by hand.
 */
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { join } from "node:path";

export const REPOSITORY = "https://github.com/checodo/better-auth-plugins";

export interface PackageChangelog {
  /** The package's directory under `packages/`, e.g. `waitlist`; also its page's slug. */
  dir: string;
  /** The npm name, e.g. `@checodo/better-auth-waitlist`. */
  name: string;
  /** The title of its docs page, e.g. `Waitlist`. */
  title: string;
  /** The contents of its `CHANGELOG.md`. */
  changelog: string;
}

const GENERATED =
  "{/* Generated by scripts/changelog.mts from the packages' CHANGELOG.md files. Don't edit. */}";

/**
 * Escapes what MDX would read as JSX or an expression (`<`, `{`, `}`) in
 * Markdown text, leaving inline code alone. Autolinks (`<https://…>`),
 * which MDX doesn't support, become links.
 */
export function escapeMdx(line: string): string {
  return line
    .split(/(`+[^`]*`+|<(?:https?|mailto):[^<>\s]+>)/)
    .map((part, index) => {
      if (index % 2 === 0) return part.replace(/[<{}]/g, (char) => `\\${char}`);
      if (part.startsWith("`")) return part;
      const url = part.slice(1, -1);
      return `[${url}](${url})`;
    })
    .join("");
}

/** A heading id: lowercase letters, digits, and dashes. */
function slug(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

/** The GitHub release of a version, tagged `<name>@<version>` by the release workflow. */
export function releaseUrl(name: string, version: string): string {
  return `${REPOSITORY}/releases/tag/${encodeURIComponent(`${name}@${version}`)}`;
}

/** The newest version in a `CHANGELOG.md` (its first `## <version>` heading). */
export function latestVersion(changelog: string): string | undefined {
  return /^## (\S+)\s*$/m.exec(changelog)?.[1];
}

/** A plugin's changelog page, from its `CHANGELOG.md`. */
export function renderPackagePage({ dir, name, title, changelog }: PackageChangelog): string {
  const out = [
    "---",
    `title: ${title}`,
    `description: Every release of ${name}, newest first.`,
    "---",
    "",
    GENERATED,
    "",
    `[\`${name}\`](https://www.npmjs.com/package/${name}) · [${title} docs](/docs/${dir}) · [All plugins](/docs/changelog)`,
    "",
  ];
  let inFence = false;
  for (const line of changelog.split("\n")) {
    if (/^\s*(```|~~~)/.test(line)) {
      // Samples of old versions aren't type-checked against today's code.
      out.push(!inFence && !/no-check/.test(line) ? `${line.trimEnd()} no-check` : line);
      inFence = !inFence;
      continue;
    }
    if (inFence) {
      out.push(line);
      continue;
    }
    // `# <name>`: the page title replaces it.
    if (/^# /.test(line)) continue;
    const version = /^## (\S+)\s*$/.exec(line)?.[1];
    if (version) {
      // Fumadocs makes each heading a link to itself: the release link
      // goes below it (a link inside a link breaks hydration).
      out.push(
        `## ${version} [#v${slug(version)}]`,
        "",
        `[Release on GitHub](${releaseUrl(name, version)})`,
      );
      continue;
    }
    // `- <commit>: <text>`: the commit becomes a link.
    const entry = /^- ([0-9a-f]{7,40}): (.*)$/.exec(line);
    if (entry) {
      const [, commit, text] = entry as unknown as [string, string, string];
      out.push(`- [${commit}](${REPOSITORY}/commit/${commit}): ${escapeMdx(text)}`);
      continue;
    }
    // `### Minor Changes` and the like stay as they are.
    out.push(escapeMdx(line));
  }
  // Removing the `# <name>` line leaves blank lines behind: keep one.
  return `${out
    .join("\n")
    .replace(/\n{3,}/g, "\n\n")
    .trimEnd()}\n`;
}

/** The overview: the `0.x` note and a card per plugin with its current version. */
export function renderIndexPage(packages: PackageChangelog[]): string {
  const cards = packages.map((pkg) => {
    const latest = latestVersion(pkg.changelog);
    return [
      "  <Card",
      `    title="${pkg.title}"`,
      `    href="/docs/changelog/${pkg.dir}"`,
      `    description="${pkg.name}${latest ? ` ${latest}` : ""}"`,
      "  />",
    ].join("\n");
  });
  return [
    "---",
    "title: Changelog",
    "description: What changed in each release of each plugin.",
    "---",
    "",
    GENERATED,
    "",
    "Each plugin is versioned and released on its own, so each has its own",
    "changelog. The entries come from the packages' `CHANGELOG.md` files; each",
    `version links to its [GitHub release](${REPOSITORY}/releases), which also`,
    "carries the published tarball, its SBOM, and signed build provenance.",
    "",
    '<Callout title="Versions below 1.0">',
    "  While a plugin is on `0.x`, a minor version (`0.3.0`) may contain breaking changes;",
    "  its entry says so. Patch versions (`0.3.1`) only fix things.",
    "</Callout>",
    "",
    "<Cards>",
    ...cards,
    "</Cards>",
    "",
  ].join("\n");
}

/**
 * The folder's `meta.json`: the plugins. The overview (`index`) is left
 * out, so the folder title itself links to it, like Authentication's;
 * listed, it would appear a second time as "Changelog" inside the folder.
 */
export function renderMeta(packages: PackageChangelog[]): string {
  const meta = { title: "Changelog", pages: packages.map((p) => p.dir) };
  return `${JSON.stringify(meta, null, 2)}\n`;
}

/** The title in a docs page's front matter. */
function pageTitle(page: string): string {
  const title = /^title:\s*(.+)$/m.exec(readFileSync(page, "utf8"))?.[1];
  if (!title) throw new Error(`No title in ${page}.`);
  return title.trim();
}

/** Every published package with a `CHANGELOG.md`, in the order of their directories. */
export function readPackages(root: string, contentDir: string): PackageChangelog[] {
  const packagesDir = join(root, "packages");
  return readdirSync(packagesDir)
    .sort()
    .flatMap((dir) => {
      const manifest = JSON.parse(readFileSync(join(packagesDir, dir, "package.json"), "utf8")) as {
        name: string;
        private?: boolean;
      };
      const changelogPath = join(packagesDir, dir, "CHANGELOG.md");
      if (manifest.private || !existsSync(changelogPath)) return [];
      const page = [join(contentDir, `${dir}.mdx`), join(contentDir, dir, "index.mdx")].find(
        existsSync,
      );
      if (!page) throw new Error(`No docs page for ${manifest.name} (packages/${dir}).`);
      return [
        {
          dir,
          name: manifest.name,
          title: pageTitle(page),
          changelog: readFileSync(changelogPath, "utf8"),
        },
      ];
    });
}

/** Replaces `outDir` with the overview, a page per package, and `meta.json`. */
export function writeChangelog(outDir: string, packages: PackageChangelog[]): void {
  rmSync(outDir, { recursive: true, force: true });
  mkdirSync(outDir, { recursive: true });
  writeFileSync(join(outDir, "index.mdx"), renderIndexPage(packages));
  for (const pkg of packages) {
    writeFileSync(join(outDir, `${pkg.dir}.mdx`), renderPackagePage(pkg));
  }
  writeFileSync(join(outDir, "meta.json"), renderMeta(packages));
}

if (import.meta.main) {
  const docsRoot = join(import.meta.dirname, "..");
  const contentDir = join(docsRoot, "content/docs");
  const packages = readPackages(join(docsRoot, "../.."), contentDir);
  writeChangelog(join(contentDir, "changelog"), packages);
  console.log(`Changelog: ${packages.map((p) => p.name).join(", ")}`);
}
